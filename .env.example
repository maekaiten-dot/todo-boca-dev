# ── Fichadas (SOLO servidor: van en Vercel → Settings → Environment Variables, sin prefijo VITE_) ──
# Planilla aparte para FICHADAS y DISPOSITIVOS, compartida solo con la cuenta de servicio de abajo
FICHADAS_SHEET_ID=
FICHADAS_GOOGLE_CLIENT_EMAIL=fichadas@proyecto.iam.gserviceaccount.com
FICHADAS_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
