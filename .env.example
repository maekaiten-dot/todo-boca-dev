# ── Fichadas (SOLO servidor: van en Vercel → Settings → Environment Variables, sin prefijo VITE_) ──
# Obligatorias:
FICHADAS_SECRET=          # texto al azar de 32+ caracteres
FICHADAS_ADMIN_PIN=       # PIN para habilitar la tablet y vincular celulares
# Opcionales: planilla y cuenta de servicio propias para fichadas (más seguro).
# Si no se cargan, se usan VITE_SHEET_ID / VITE_GOOGLE_CLIENT_EMAIL / VITE_GOOGLE_PRIVATE_KEY.
# FICHADAS_SHEET_ID=
# FICHADAS_GOOGLE_CLIENT_EMAIL=
# FICHADAS_GOOGLE_PRIVATE_KEY=
